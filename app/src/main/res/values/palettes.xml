        <item name="hnMeta">#787067</item>
        <item name="hnSideBg">#fbe9d8</item>
        <item name="hnBubbleText">#716961</item>
        <item name="hnBubbleTint">@null</item>
        <item name="hnPointsTint">@null</item>
        <item name="hnEmptyText">#c3b5a7</item>
        <item name="hnLoadMoreBg">#c3b5a7</item>
        <item name="hnLoadMoreText">#ffeddb</item>
        <item name="hnCommentInfo">@color/gray_comments_information</item>
        <item name="hnCommentText">#262321</item>
        <item name="hnActionBarBg">@drawable/actionbar_bg_orange</item>
        <item name="hnActionBarText">@android:color/white</item>
        <item name="hnArticleBarBg">@drawable/actionbar_bg_bright</item>
        <item name="hnArticleBarText">@color/gray_article_title</item>
        <item name="hnRefreshTint">@color/dark_gray_post_title</item>
        <item name="hnListSelector">@drawable/main_list_selector</item>
